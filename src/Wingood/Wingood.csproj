<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AssemblyName>wingood</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.1.0</Version>
    <MicrosoftManagementDeployment-FactoryLinkage>static</MicrosoftManagementDeployment-FactoryLinkage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <ProjectReference Include="..\Wingood.Core\Wingood.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.30.100-preview" />
  </ItemGroup>
  <!-- Publish can retain a newer-timestamped activation DLL when switching SDK
       branches. Always publish the exact native bridge from this build. -->
  <Target Name="PublishWinGetActivationFactory" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)Microsoft.Management.Deployment.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
